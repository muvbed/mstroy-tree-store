{
  "name": "mstroy-tree-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node --watch --env-file .env server/index.ts",
    "seed": "node --env-file .env server/seed.ts",
    "dev": "vite --open",
    "dev:all": "run-p server dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "lint": "eslint .",
    "type-check": "vue-tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ag-grid-community": "^36.2.0",
    "ag-grid-enterprise": "^36.2.0",
    "ag-grid-vue3": "^36.2.0",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "pinia": "^4.0.3",
    "uuid": "^14.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "mongodb-memory-server": "^11.3.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
